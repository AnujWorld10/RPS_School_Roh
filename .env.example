APP_NAME=school-management-api
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local MySQL — adjust user, password, host, port, and database name to match your install
DATABASE_URL=mysql+pymysql://root:mysql@localhost:3306/school_db

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Set both values to bootstrap the first SUPER_ADMIN. Use a unique strong password.
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=Admin@123

# Required by the optional Docker Compose MySQL service.
# MYSQL_ROOT_PASSWORD=

PASSWORD_HASH_SCHEME=argon2
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_PREFIX=RPS
LOG_ERROR_FILE_PREFIX=RPS_ERROR
LOG_RETENTION_DAYS=30
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
# Seed the database automatically at application startup only when enabled.
SEED_ON_STARTUP=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
